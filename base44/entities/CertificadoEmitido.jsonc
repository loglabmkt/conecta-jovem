{
  "name": "CertificadoEmitido",
  "type": "object",
  "properties": {
    "template_id": {
      "type": "string",
      "description": "ID do template utilizado"
    },
    "codigo_rastreio": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico de rastreio"
    },
    "nome_aluno": {
      "type": "string",
      "description": "Nome completo do aluno"
    },
    "nome_curso": {
      "type": "string",
      "description": "Nome do curso ou evento"
    },
    "data_conclusao": {
      "type": "string",
      "description": "Data de conclus\u00e3o"
    },
    "pdf_url": {
      "type": "string",
      "description": "URL do PDF gerado (opcional)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "template_id",
    "codigo_rastreio",
    "nome_aluno",
    "nome_curso",
    "data_conclusao"
  ]
}