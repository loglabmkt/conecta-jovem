{
  "name": "Conteudo",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do conte\u00fado"
    },
    "subtitulo": {
      "type": "string",
      "description": "Subt\u00edtulo do conte\u00fado (opcional)"
    },
    "texto": {
      "type": "string",
      "description": "Texto completo do conte\u00fado"
    },
    "imagem_capa": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorias do conte\u00fado"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags do conte\u00fado"
    },
    "autor": {
      "type": "string",
      "default": "Equipe Conecta Jovem",
      "description": "Autor do conte\u00fado"
    },
    "slug": {
      "type": "string",
      "description": "URL amig\u00e1vel gerada automaticamente"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de publica\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Conte\u00fado ativo/inativo"
    }
  },
  "required": [
    "titulo",
    "texto",
    "imagem_capa"
  ]
}