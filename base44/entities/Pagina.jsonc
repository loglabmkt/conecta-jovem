{
  "name": "Pagina",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo principal da p\u00e1gina"
    },
    "subtitulo": {
      "type": "string",
      "description": "Subt\u00edtulo opcional"
    },
    "slug": {
      "type": "string",
      "description": "URL amig\u00e1vel gerada automaticamente"
    },
    "imagem_capa": {
      "type": "string",
      "description": "URL da imagem de capa (hero)"
    },
    "video_ou_imagem_coluna": {
      "type": "string",
      "description": "URL de v\u00eddeo YouTube ou imagem para coluna esquerda"
    },
    "tipo_midia_coluna": {
      "type": "string",
      "enum": [
        "imagem",
        "video"
      ],
      "default": "imagem",
      "description": "Tipo de m\u00eddia da coluna"
    },
    "texto_coluna_direita": {
      "type": "string",
      "description": "Texto da coluna direita"
    },
    "texto_adicional": {
      "type": "string",
      "description": "Texto adicional opcional abaixo das colunas"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "P\u00e1gina ativa/inativa"
    },
    "data_publicacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de publica\u00e7\u00e3o"
    }
  },
  "required": [
    "titulo",
    "imagem_capa",
    "texto_coluna_direita"
  ]
}