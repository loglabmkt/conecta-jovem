{
  "name": "Slider",
  "type": "object",
  "properties": {
    "imagem_desktop": {
      "type": "string",
      "description": "URL da imagem para desktop/widescreen"
    },
    "imagem_mobile": {
      "type": "string",
      "description": "URL da imagem para mobile (opcional)"
    },
    "ordem": {
      "type": "integer",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o do slide"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Slide ativo/inativo"
    },
    "link_destino": {
      "type": "string",
      "description": "URL de destino quando o slide \u00e9 clicado (opcional)"
    }
  },
  "required": [
    "imagem_desktop"
  ]
}